# Backend Environment Variables (Phase 0 Foundation)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://rescuehive:rescuehive_secure_pass@localhost:5432/rescuehive_db
JWT_SECRET=supersecret-insecure-key-for-development-only-change-in-production
