# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./rescuehive.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/rescuehive

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ALGORITHM=HS256

# Redis (optional for single-worker dev)
# REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# S3-compatible storage (optional, falls back to local ./uploads)
# S3_BUCKET=rescuehive-media
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Seed demo data on startup (set to 0 in production)
SEED_ON_STARTUP=1
