# RescueHive Environment Configuration (Phase 0 Foundation)

# Environment
ENVIRONMENT=development
PROJECT_NAME="RescueHive — AI-Powered Multi-Robot Disaster Intelligence System"

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security
JWT_SECRET=your-super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database
POSTGRES_USER=rescuehive
POSTGRES_PASSWORD=rescuehive_secure_pass
POSTGRES_DB=rescuehive_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://rescuehive:rescuehive_secure_pass@localhost:5432/rescuehive_db

# External Simulator Integration (Phase 4 Placeholder)
SIMULATOR_WS_URL=ws://localhost:9000/telemetry
SIMULATOR_API_URL=http://localhost:9000
