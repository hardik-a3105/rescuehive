# ==========================================
# RescueHive — Comprehensive .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Python Environments & Caches
venv/
.venv/
*/venv/
*/.venv/
env/
*/env/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*/dist/

# Frontend Builds & Caches
dist/
build/
.vite/
*/.vite/
.eslintcache
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
coverage/

# Logs & Databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.sqlite3
*.db
*.sqlite

# AI / ML Large Weights & Checkpoints (Place in cloud storage or models registry)
ai/models/*.pt
ai/models/*.pth
ai/models/*.onnx
ai/models/*.bin
ai/models/*.engine
ai/models/*.h5
ai/models/*.tflite
!ai/models/.gitkeep

# IDEs & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
